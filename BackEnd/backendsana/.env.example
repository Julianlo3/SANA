# ==============================================================
# Variables de entorno de SANA
# Copia este archivo como `.env` y reemplaza los valores de ejemplo.
# Nunca subas el `.env` real al repositorio.
# ==============================================================

# -- Despliegue local --
# Puerto en el que escucha el backend
PORT=3000
# URL del frontend permitida por CORS (en desarrollo, Vite usa el puerto 5173)
CORS_ORIGIN=http://localhost:5173
# Número de proxies inversos en los que confiar (trust proxy de Express).
# 0 = sin proxy (local); 1 = detrás de un proxy/balanceador (p. ej. Render, Nginx)
TRUST_PROXY_HOPS=0
# Versión vigente de la política de privacidad (se guarda al registrar la aceptación del usuario)
POLICY_VERSION=privacy-policy-2026-01

# -- Base de datos PostgreSQL --
# Estos datos salen de la configuración de conexión de tu base de datos
# Host del servidor PostgreSQL
DATABASE_HOST=localhost
# Puerto de PostgreSQL (el predeterminado es 5432; aquí se usa 5433)
DATABASE_PORT=5433
# Usuario de la base de datos
DATABASE_USERNAME=postgres
# Contraseña del usuario de la base de datos
DATABASE_PASSWORD=replace_with_database_password
# Nombre de la base de datos
DATABASE_NAME=DB_SANA
# Conexión SSL a la base de datos: false en local, true en proveedores en la nube que lo exijan
DATABASE_SSL=false

# -- Auth0 --
# Se obtienen en https://manage.auth0.com/dashboard/us/oztpbueuvsduygklyy5u/applications/1423
# Dominio del tenant de Auth0 (sin https://), p. ej. mi-tenant.us.auth0.com
AUTH0_DOMAIN=replace_with_auth0_domain
# Identifier de la API registrada en Auth0 (Applications → APIs).
# El backend lo usa para validar el campo `aud` de los tokens JWT
AUTH0_AUDIENCE=https://api.sana.example.com
# Prefijo (namespace) de los claims personalizados que Auth0 agrega al token,
# p. ej. https://sana.app/roles. Debe coincidir con el definido en la Action/Rule de Auth0
AUTH0_CLAIM_NAMESPACE=https://sana.app

# -- Cloudinary (almacenamiento de imágenes) --
# Se obtienen en https://console.cloudinary.com → Dashboard / API Keys
# Nombre de la cuenta (cloud name)
CLOUDINARY_CLOUD_NAME=
# API Key de Cloudinary
CLOUDINARY_API_KEY=
# API Secret de Cloudinary (privado, no lo expongas en el frontend)
CLOUDINARY_API_SECRET=
# Carpeta de Cloudinary donde se guardan las imágenes (usa una distinta por entorno)
CLOUDINARY_FOLDER=sana-dev
# Cantidad máxima de banners activos al mismo tiempo
BANNERS_MAX_ACTIVE=5

# -- Gmail API (envío de correos con OAuth2) --
# Se crean en https://console.cloud.google.com → APIs y servicios → Credenciales
# Client ID de la credencial OAuth 2.0
GMAIL_CLIENT_ID=
# Client Secret de la credencial OAuth 2.0
GMAIL_CLIENT_SECRET=
# URI de redirección autorizada en Google Cloud (debe coincidir exactamente)
GMAIL_REDIRECT_URI=
# Refresh token de la cuenta emisora (se genera una vez con el flujo OAuth, p. ej. en OAuth 2.0 Playground)
GMAIL_REFRESH_TOKEN=
# Dirección remitente de los correos, p. ej. SANA <no-reply@tudominio.com>
GMAIL_FROM=

# -- Wompi (Bancolombia) --
# Claves disponibles en https://dashboard.wompi.co → Desarrolladores
# Las que aparecen aquí son de ejemplo para el entorno de pruebas (test).
# Llave privada: autentica las llamadas del backend a la API de Wompi
WOMPI_PRIVATE_KEY=prv_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Secreto de eventos: valida la firma de los webhooks que envía Wompi.
# Solo es necesario cuando el backend implemente el receptor de eventos
# (transacciones que pasan de PENDING a APPROVED)
WOMPI_EVENTS_SECRET=test_events_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Secreto de integridad: se usa para generar la firma SHA-256 de cada transacción
# (referencia + monto + moneda + secreto) antes de iniciar el pago
WOMPI_INTEGRITY_SECRET=test_integrity_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX