# ==============================================================
# Variables de entorno del frontend de SANA (Next.js)
# Copia este archivo como `.env.local` y reemplaza los valores de ejemplo.
# Nunca subas el `.env.local` real al repositorio.
#
# Las variables con prefijo NEXT_PUBLIC_ se incluyen en el bundle del
# navegador y son visibles para cualquiera. Las demás solo existen en
# el servidor (Server Actions, Route Handlers, proxy).
# ==============================================================

# -- Auth0 --
# Se obtienen en https://manage.auth0.com → Applications → tu aplicación → Settings
# Dominio del tenant de Auth0 (sin https://). Debe ser el mismo tenant que usa el backend
AUTH0_DOMAIN=replace_with_your_tenant.us.auth0.com
# Client ID de la aplicación (tipo "Regular Web Application")
AUTH0_CLIENT_ID=replace_with_auth0_client_id
# Client Secret de la aplicación (privado, solo servidor)
AUTH0_CLIENT_SECRET=replace_with_auth0_client_secret
# Secreto aleatorio para cifrar la cookie de sesión (mínimo 32 caracteres).
# Generar con: openssl rand -hex 32
AUTH0_SECRET=replace_with_random_secret_min_32_chars
# Identifier de la API del backend en Auth0. Debe ser idéntico al
# AUTH0_AUDIENCE del backend, o los tokens serán rechazados
AUTH0_AUDIENCE=https://api.sana.example.com
# Permisos solicitados al iniciar sesión.
# `offline_access` habilita el refresh token (requiere activar "Allow Offline Access" en la API de Auth0)
AUTH0_SCOPE="openid profile email offline_access"

# -- URLs de la aplicación --
# URL pública del frontend, sin barra final. Auth0 la usa para construir las URLs
# de callback y logout, y el proxy como Origin.
# Debe coincidir con CORS_ORIGIN del backend y estar registrada en
# "Allowed Callback URLs" y "Allowed Logout URLs" de Auth0
APP_BASE_URL=http://localhost:5173
# URL interna del backend NestJS. Solo la usa el servidor de Next.js (proxy y Server Actions)
BACKEND_API_URL=http://localhost:3000/api/v1
# URL del backend accesible desde el navegador. Solo para componentes de prueba/desarrollo;
# el flujo normal pasa por el proxy
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# -- Wompi (Bancolombia) --
# Claves disponibles en https://dashboard.wompi.co → Desarrolladores
# Los valores de ejemplo son de SANDBOX (prefijos test_ / pub_test_) y no mueven dinero real.
# En producción reemplázalos por las claves de producción (prefijos prod_ / pub_prod_)

# Llave pública: es seguro exponerla en el navegador.
# Identifica al comercio ante Wompi en el widget de pago
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Secreto de integridad (solo servidor, nunca llega al navegador).
# Se usa en Server Actions para generar la firma SHA-256 que protege
# los parámetros del pago (referencia + monto + moneda)
WOMPI_INTEGRITY_SECRET=test_integrity_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Llave privada (solo servidor).
# Se usa en Server Actions para consultar a la API de Wompi el estado real
# de una transacción antes de registrarla
WOMPI_PRIVATE_KEY=prv_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# -- Comisión de Wompi (transparencia con el donante) --
# Porcentaje que cobra Wompi por transacción, expresado como decimal
# (0.0299 = 2.99 %, 0.015 = 1.5 %).
# El frontend lo usa para mostrar cuánto recibe realmente la fundación y
# ofrecer al donante cubrir la comisión. Estos valores son públicos (NEXT_PUBLIC_).
# Verifica las tarifas vigentes en https://wompi.co/tarifas
# Comisión para pagos con tarjeta
NEXT_PUBLIC_WOMPI_FEE_CARD=0.0299
# Comisión para pagos con PSE
NEXT_PUBLIC_WOMPI_FEE_PSE=0.015