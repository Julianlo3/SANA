# URL base del backend NestJS (incluye el prefijo /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# En true, los servicios responden con datos de prueba.
# En false, pegan contra la API real.
NEXT_PUBLIC_USE_MOCKS=true

# Mismo valor que GOOGLE_CLIENT_ID del backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace_with_google_client_id