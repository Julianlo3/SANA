# Copia este archivo a ".env" y ajusta los valores segun tu entorno.

# Nombre del contenedor
CONTAINER_NAME=db_sana

# Tag de la imagen oficial de Postgres
POSTGRES_VERSION=18-alpine

# Nombre de la base de datos, usuario y contrasena
POSTGRES_DB=DB_SANA
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<cambia_esta_clave>

# Puerto expuesto en el host
POSTGRES_PORT=5433

# Nombres de volumen y red
VOLUME_NAME=db_sana_data
NETWORK_NAME=db_sana_net
